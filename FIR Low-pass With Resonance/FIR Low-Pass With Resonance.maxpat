                                    "code": "Delay dl(48000);\n\r\nfreq = in2;\r\nperiod = samplerate / freq;\nnumCycles = in3;\nfeedback = in4;\nN = min(period * numCycles, 48000);\ndl.write(in1);\nsum_cos = 0;\nfor (i = 0; i < N; i = i + 1) {\n    tap = dl.read(i, 0);\n    angle = TWOPI * i / period;\n    cycle_index = floor(i / period);\n    weight = pow(feedback, cycle_index);\n    sum_cos += tap * cos(angle) * weight;\n}\nnorm = (1.0 - pow(feedback, numCycles)) / (1.0 - feedback + 0.00001);\nout1 = sum_cos / norm;",
