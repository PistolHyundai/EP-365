                            {
                                "box": {
                                    "code": "cf = in1;\r\ngain = in2;\r\nQ = in3;\r\n\r\nomega = cf * twopi/samplerate;\nsn = sin(omega);\ncs = cos(omega);\nalpha = sn * 0.5/Q;\r\n\r\nA = sqrt(gain); \none_over_A = 1./A; \r\nb0 = 1./(1. + alpha*one_over_A);\r\n\r\na0 = (1. + alpha*A) * b0;\nb1 = (-2. * cs) * b0;\r\na1 = b1;\na2 = (1. - alpha*A) * b0;\nb2 = (1. - alpha*one_over_A) * b0;\r\n\r\nout1 = a0;\r\nout2 = a1;\r\nout3 = a2;\r\nout4 = b1;\r\nout5 = b2;",
                                    "fontface": 0,
