                            {
                                "box": {
                                    "code": "ctlin = (in1);\r\n\r\nctl1 = clamp(ctlin + 1., 0., 1.) - clamp(ctlin, 0., 1.);\nctl2 = clamp(ctlin, 0., 1.) - clamp(ctlin - 1., 0., 1.);\nctl3 = clamp(ctlin - 1., 0., 1.) - clamp(ctlin - 2., 0., 1.);\nctl4 = clamp(ctlin - 2., 0., 1.) - clamp(ctlin - 3., 0., 1.);\nctl5 = clamp(ctlin - 3., 0., 1.) - clamp(ctlin - 4., 0., 1.);\nctl6 = clamp(ctlin - 4., 0., 1.) - clamp(ctlin - 5., 0., 1.);\r\nctl7 = clamp(ctlin - 5., 0., 1.) - clamp(ctlin - 6., 0., 1.);\r\nctl8 = clamp(ctlin - 6., 0., 1.) - clamp(ctlin - 7., 0., 1.);\r\nctl9 = clamp(ctlin - 7., 0., 1.) - clamp(ctlin - 8., 0., 1.);\nctl10 = clamp(ctlin - 8., 0., 1.) - clamp(ctlin - 9., 0., 1.);\nctl11 = clamp(ctlin - 9., 0., 1.) - clamp(ctlin - 10., 0., 1.);\n\n\n\r\n\r\n\r\n\r\nscale1 = (ctl1*.25)+.75;\nscale2 = (ctl2*.25)+.75;\nscale3 = (ctl3*.25)+.75;\nscale4 = (ctl4*.25)+.75;\nscale5 = (ctl5*.25)+.75;\r\nscale6 = (ctl6*.25)+.75;\r\nscale7 = (ctl7*.25)+.75;\r\nscale8 = (ctl8*.25)+.75;\r\nscale9 = (ctl9*.25)+.75;\r\nscale10 = (ctl10*.25)+.75;\r\nscale11 = (ctl11*.25)+.75;\r\n\r\n\r\n\r\n\r\n\r\n\nctlsin1 = cycle (scale1, index=\"phase\");\nctlsin2 = cycle (scale2, index=\"phase\");\nctlsin3 = cycle (scale3, index=\"phase\");\nctlsin4 = cycle (scale4, index=\"phase\");\nctlsin5 = cycle (scale5, index=\"phase\");\r\nctlsin6 = cycle (scale6, index=\"phase\");\r\nctlsin7 = cycle (scale7, index=\"phase\");\r\nctlsin8 = cycle (scale8, index=\"phase\");\r\nctlsin9 = cycle (scale9, index=\"phase\");\r\nctlsin10 = cycle (scale10, index=\"phase\");\r\nctlsin11 = cycle (scale11, index=\"phase\");\n\n\n\n\n\n\n\nsig1 = (in2 * ctlsin1) + (in3 * ctlsin2) + (in4 * ctlsin3) + (in5 * ctlsin4) + (in6 * ctlsin5) + (in7 * ctlsin6) + (in8 * ctlsin7) + (in9 * ctlsin8) + (in10 * ctlsin9) + (in11 * ctlsin10) + (in12 * ctlsin11);\r\nout1 = sig1;\r\n",
